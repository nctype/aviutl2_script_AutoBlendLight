--information:AutoBlendLight v1.3.2
--label:AutoBlendLight
--require:2003700

--group:オブジェクト,true
--track@bright:明るさ,0,200,75,1
--group

--group:ライティング,true
--select@color_mode:カラーモード,単色=0,2色（左右）=1
--select@light_style:スタイル,グラデーション=0,縁取り=1
--check@backlight_mode:逆光,1
--track@light_strength:強さ,0,200,100,1
--track@light_diffusion:拡散,0,200,25,1
--track@light_ratio:偏り,-100,100,-90,1
--track@color_mix:自然補正,0,200,100,1
--track@color_density:彩度,0,200,100,1
--check@brightness_link:明るさ連動,1
--group

--group:ライティング範囲,true
--figure@mask_type:種類,円
--track@mask_x:X,-4000,4000,0,1
--track@mask_y:Y,-4000,4000,0,1
--track@mask_size:サイズ,0,8000,2000,1
--track@mask_blur:縁ぼかし,0,1000,0,1
--track@mask_rotation:角度,-360,360,0,0.1
--track@mask_aspect:縦横比,-100,100,0,0.1
--group

--group:環境なじませ,true
--track@env_blend:なじませ量,0,100,30,1
--track@env_blur:背景ぼかし,0,1000,500,1
--group

--group:固定光源,false
--check@fixed_light:固定光源モード,0
--group

--[[pixelshader@backlight_env_framebuffer:
Texture2D frame_tex : register(t0);
Texture2D mask_tex  : register(t1);
Texture2D bg_tex    : register(t2);
SamplerState smp    : register(s0);

cbuffer constant0 : register(b0) {
    float4 c0; // multiplyOpacity, reserved, reserved, reserved
};

float4 backlight_env_framebuffer(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 base = frame_tex.Sample(smp, uv);
    float opacity = saturate(c0.x);

    if (opacity <= 0.00001 || base.a <= 0.00001) {
        return base;
    }

    // The mask is already rendered in framebuffer/screen space by obj.draw().
    // This means X/Y/Z, Center X/Y/Z, rotations, scale and camera projection
    // are all handled by AviUtl2 itself instead of being reconstructed here.
    float4 mask = mask_tex.Sample(smp, uv);
    if (mask.a <= 0.00001) {
        return base;
    }

    float4 bg = bg_tex.Sample(smp, uv);

    float3 baseRGB = base.rgb / max(base.a, 0.00001);
    float3 bgRGB = float3(1.0, 1.0, 1.0);
    if (bg.a > 0.00001) {
        bgRGB = saturate(bg.rgb / bg.a);
    }

    float amount = opacity * saturate(mask.a);
    float3 multiplied = baseRGB * bgRGB;
    float3 outRGB = lerp(baseRGB, multiplied, amount);

    return float4(outRGB * base.a, base.a);
}
]]

--[[pixelshader@backlight_proxy_resize:
Texture2D src_tex : register(t0);
SamplerState smp  : register(s0);

cbuffer constant0 : register(b0) {
    float4 c0; // sourceW, sourceH, canvasW, canvasH
    float4 c1; // sourceOffsetX, sourceOffsetY, reserved, reserved
};

float4 backlight_proxy_resize(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float2 sourceSize = max(c0.xy, float2(1.0, 1.0));
    float2 canvasSize = max(c0.zw, float2(1.0, 1.0));

    // uv describes the rebuilt pre-clipping canvas.
    float2 canvasPos = uv * canvasSize;
    float2 srcPos = canvasPos - c1.xy;

    if (srcPos.x < 0.0 || srcPos.y < 0.0 ||
        srcPos.x >= sourceSize.x || srcPos.y >= sourceSize.y) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    // SV/TEXCOORD UV already points at the destination pixel center.
    // canvasPos/srcPos therefore already represent pixel-center coordinates.
    // Adding another +0.5 shifts every sample by half a pixel and softens
    // line art even when no actual downscaling is taking place.
    float2 srcUV = srcPos / sourceSize;
    return src_tex.Sample(smp, saturate(srcUV));
}
]]

--[[pixelshader@backlight_dualcolor_mix:
Texture2D left_tex  : register(t0);
Texture2D right_tex : register(t1);
SamplerState smp    : register(s0);

cbuffer constant0 : register(b0) {
    float4 c0; // transition, reserved, reserved, reserved
};

float4 backlight_dualcolor_mix(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 leftColor = left_tex.Sample(smp, uv);
    float4 rightColor = right_tex.Sample(smp, uv);

    float transition = saturate(c0.x);
    float halfWidth = lerp(0.02, 0.30, transition);
    float tx = smoothstep(0.5 - halfWidth, 0.5 + halfWidth, uv.x);

    return lerp(leftColor, rightColor, tx);
}
]]

--[[pixelshader@backlight_outline_only:
Texture2D outline_tex : register(t0);
Texture2D base_tex   : register(t1);
SamplerState smp     : register(s0);

cbuffer constant0 : register(b0) {
    float4 c0; // outlineW, outlineH, baseW, baseH
    float4 c1; // r, g, b, effectiveStrength
    float4 c2; // innerWidthPx, reserved, reserved, reserved
};

float sample_base_alpha(float2 baseUV) {
    return base_tex.Sample(smp, saturate(baseUV)).a;
}

float4 backlight_outline_only(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 outlined = outline_tex.Sample(smp, uv);

    float2 outlineSize = c0.xy;
    float2 baseSize = c0.zw;
    float2 offset = (outlineSize - baseSize) * 0.5;

    float2 basePos = pos.xy - offset;
    float baseA = 0.0;
    float innerA = 0.0;

    if (basePos.x >= 0.0 && basePos.y >= 0.0 &&
        basePos.x < baseSize.x && basePos.y < baseSize.y) {

        float2 baseUV = basePos / baseSize;
        baseA = sample_base_alpha(baseUV);

        float innerWidth = max(c2.x, 0.0);

        if (innerWidth > 0.05 && baseA > 0.00001) {
            float2 px = float2(
                innerWidth / max(baseSize.x, 1.0),
                innerWidth / max(baseSize.y, 1.0)
            );
            float2 dg = px * 0.70710678;

            // Erode the original alpha at the requested radius.
            // The difference between the original alpha and this eroded alpha
            // becomes the INNER part of the rim.
            float eroded = baseA;
            eroded = min(eroded, sample_base_alpha(baseUV + float2( px.x, 0.0)));
            eroded = min(eroded, sample_base_alpha(baseUV + float2(-px.x, 0.0)));
            eroded = min(eroded, sample_base_alpha(baseUV + float2(0.0,  px.y)));
            eroded = min(eroded, sample_base_alpha(baseUV + float2(0.0, -px.y)));
            eroded = min(eroded, sample_base_alpha(baseUV + float2( dg.x,  dg.y)));
            eroded = min(eroded, sample_base_alpha(baseUV + float2(-dg.x,  dg.y)));
            eroded = min(eroded, sample_base_alpha(baseUV + float2( dg.x, -dg.y)));
            eroded = min(eroded, sample_base_alpha(baseUV + float2(-dg.x, -dg.y)));

            innerA = saturate(baseA - eroded);
        }
    }

    // AviUtl2's native Outline effect provides the OUTER part.
    // Subtract the original object's alpha so only the outside contour remains.
    float outerA = saturate(outlined.a - baseA);

    // Strength changes visibility/brightness, not the inner/outer width split.
    float effectiveStrength = max(c1.a, 0.0);
    float alphaScale = saturate(effectiveStrength / 100.0);
    float whiteBoost = saturate((effectiveStrength - 100.0) / 100.0) * 0.35;

    float3 tint = lerp(saturate(c1.rgb), float3(1.0, 1.0, 1.0), whiteBoost);

    float rimA = saturate(max(innerA, outerA)) * alphaScale;
    return float4(tint * rimA, rimA);
}
]]



local pi = math.pi

local src_w = obj.w
local src_h = obj.h
local screen_w = obj.screen_w
local screen_h = obj.screen_h

if src_w <= 0 or src_h <= 0 or screen_w <= 0 or screen_h <= 0 then
    return
end

local function clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

local function luminance(r, g, b)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b
end

local function rgb_to_hsl(r, g, b)
    r = r / 255
    g = g / 255
    b = b / 255
    local maxc = math.max(r, g, b)
    local minc = math.min(r, g, b)
    local h, s
    local l = (maxc + minc) * 0.5

    if maxc == minc then
        h = 0
        s = 0
    else
        local d = maxc - minc
        if l > 0.5 then
            s = d / (2 - maxc - minc)
        else
            s = d / (maxc + minc)
        end

        if maxc == r then
            h = (g - b) / d
            if g < b then h = h + 6 end
        elseif maxc == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h / 6
    end

    return h, s, l
end

local function hue_to_rgb(p, q, t)
    if t < 0 then t = t + 1 end
    if t > 1 then t = t - 1 end
    if t < 1 / 6 then return p + (q - p) * 6 * t end
    if t < 1 / 2 then return q end
    if t < 2 / 3 then return p + (q - p) * (2 / 3 - t) * 6 end
    return p
end

local function hsl_to_rgb(h, s, l)
    local r, g, b
    if s <= 0 then
        r, g, b = l, l, l
    else
        local q
        if l < 0.5 then
            q = l * (1 + s)
        else
            q = l + s - l * s
        end
        local p = 2 * l - q
        r = hue_to_rgb(p, q, h + 1 / 3)
        g = hue_to_rgb(p, q, h)
        b = hue_to_rgb(p, q, h - 1 / 3)
    end
    return clamp(math.floor(r * 255 + 0.5), 0, 255), clamp(math.floor(g * 255 + 0.5), 0, 255), clamp(math.floor(b * 255 + 0.5), 0, 255)
end

local function tune_backlight_color(r, g, b, mix_value)
    local raw_r, raw_g, raw_b = r, g, b
    local h, s, l = rgb_to_hsl(r, g, b)
    local lum_n = luminance(r, g, b) / 255

    -- Color confidence is based on ABSOLUTE channel separation rather than
    -- HSL saturation alone. Near-black compression noise such as (0,2,0)
    -- can have a very high HSL saturation even though it contains almost no
    -- reliable color information. Near-white highlights have the same hue
    -- instability when RGB channels differ by only a few levels.
    local max_rgb = math.max(r, g, b)
    local min_rgb = math.min(r, g, b)
    local chroma_n = (max_rgb - min_rgb) / 255

    local color_confidence = clamp((chroma_n - 0.025) / 0.16, 0, 1)

    -- Very dark samples need stronger confidence before they are allowed to
    -- tint the backlight. This keeps black / almost-black footage neutral,
    -- while still allowing genuinely colored dark lights (neon, LEDs, etc.).
    if lum_n < 0.10 then
        local dark_confidence = clamp((max_rgb - 8) / 36, 0, 1)
        color_confidence = color_confidence * dark_confidence
    end

    -- Preserve clear environment colors, but collapse uncertain hue toward
    -- neutral instead of forcing a minimum saturation.
    s = clamp(s * 0.58 * color_confidence, 0, 0.46)

    l = l + (1 - l) * 0.16
    if lum_n < 0.06 then
        -- A black background has no trustworthy hue. Give it a neutral light
        -- value rather than amplifying codec/chroma noise into green/blue.
        l = 0.70
    else
        l = clamp(l, 0.52, 0.84)
    end

    local tuned_r, tuned_g, tuned_b = hsl_to_rgb(h, s, l)

    -- Uncertain colors are pulled a little farther toward white. Clear warm,
    -- cool, or neon colors keep much more of their original hue.
    local white_mix =
        0.06 +
        (1 - lum_n) * 0.05 +
        (1 - color_confidence) * 0.08

    tuned_r = clamp(math.floor(tuned_r * (1 - white_mix) + 255 * white_mix + 0.5), 0, 255)
    tuned_g = clamp(math.floor(tuned_g * (1 - white_mix) + 255 * white_mix + 0.5), 0, 255)
    tuned_b = clamp(math.floor(tuned_b * (1 - white_mix) + 255 * white_mix + 0.5), 0, 255)

    local m = clamp(mix_value, 0, 200)

    if m <= 100 then
        -- 0 = raw sampled environment color
        -- 100 = recommended automatic correction
        local t = m / 100
        return
            clamp(math.floor(raw_r + (tuned_r - raw_r) * t + 0.5), 0, 255),
            clamp(math.floor(raw_g + (tuned_g - raw_g) * t + 0.5), 0, 255),
            clamp(math.floor(raw_b + (tuned_b - raw_b) * t + 0.5), 0, 255)
    end

    -- 100..200 = progressively more neutral/white.
    local t = (m - 100) / 100
    local neutral_h, _, neutral_l = rgb_to_hsl(tuned_r, tuned_g, tuned_b)
    local neutral_r, neutral_g, neutral_b = hsl_to_rgb(
        neutral_h,
        0.05,
        clamp(neutral_l + (1 - neutral_l) * 0.55, 0, 0.94)
    )

    return
        clamp(math.floor(tuned_r + (neutral_r - tuned_r) * t + 0.5), 0, 255),
        clamp(math.floor(tuned_g + (neutral_g - tuned_g) * t + 0.5), 0, 255),
        clamp(math.floor(tuned_b + (neutral_b - tuned_b) * t + 0.5), 0, 255)
end

-- Final user saturation control, applied after automatic color correction.
-- 0 = neutral, 100 = current result, 200 = up to 2x saturation.
local function apply_color_density(r, g, b, density_value)
    local h, s, l = rgb_to_hsl(r, g, b)
    local density = clamp(density_value / 100, 0, 2)
    s = clamp(s * density, 0, 1)
    return hsl_to_rgb(h, s, l)
end


-- Automatic saturation reduction for uncertain / conflicting sampled colors.
--
-- confidence:
--   0 = nearby light candidates disagree strongly, move toward neutral
--   1 = nearby colored light candidates agree, keep the tuned saturation
--
-- The user-facing Saturation control is applied AFTER this, so the automatic decision can
-- still be overridden aesthetically without changing the sampling algorithm.
local function apply_auto_color_confidence(r, g, b, confidence)
    local h, s, l = rgb_to_hsl(r, g, b)
    confidence = clamp(confidence, 0, 1)

    -- Keep a little color even when confidence is poor, so transitions do not
    -- collapse abruptly to pure white.
    local auto_saturation_scale = 0.22 + 0.78 * confidence
    s = clamp(s * auto_saturation_scale, 0, 1)

    return hsl_to_rgb(h, s, l)
end

local has_background = obj.copybuffer("cache:aul2_backlight_bg", "framebuffer")

-- AviUtl2 skips filter effects placed after a script once that script uses
-- obj.draw(). AutoBlendLight draws multiple layers manually, so execute all
-- following effects explicitly before building our lighting result.
--
-- The clean framebuffer background has already been cached above, therefore
-- downstream object effects (including clipping) do not contaminate the
-- background used for color/brightness pickup.
obj.effect()

-- Effects such as clipping can change the actual object buffer size and
-- center offsets. Refresh the working dimensions after executing them so the
-- large-image proxy path is built from the processed object rather than the
-- pre-effect dimensions.
src_w = obj.w
src_h = obj.h
if src_w <= 0 or src_h <= 0 then
    return
end

-- Read standard clipping values from the current object.
--
-- Native clipping shrinks the image buffer, but its coordinate origin can
-- still refer to the pre-clipping image. AutoBlendLight previously built the
-- large-image proxy from the shrunken rectangle only. Once the lighting range
-- crossed that smaller rectangle, the native Mask/Light chain could disappear.
--
-- Rebuild a transparent pre-clipping canvas around the processed image so the
-- light area keeps the same coordinate space even after large crops.
local function safe_effect_value(effect_name, item_name)
    local ok, value = pcall(obj.getvalue, effect_name, item_name)
    if ok and type(value) == "number" then
        return value
    end
    return nil
end

local clip_top = 0
local clip_bottom = 0
local clip_left = 0
local clip_right = 0
local found_indexed_clip = false

for i = 0, 7 do
    local effect_name = "クリッピング:" .. tostring(i)
    local u = safe_effect_value(effect_name, "上")
    local d = safe_effect_value(effect_name, "下")
    local l = safe_effect_value(effect_name, "左")
    local r = safe_effect_value(effect_name, "右")

    if u ~= nil or d ~= nil or l ~= nil or r ~= nil then
        found_indexed_clip = true
        clip_top = clip_top + math.max(tonumber(u) or 0, 0)
        clip_bottom = clip_bottom + math.max(tonumber(d) or 0, 0)
        clip_left = clip_left + math.max(tonumber(l) or 0, 0)
        clip_right = clip_right + math.max(tonumber(r) or 0, 0)
    end
end

if not found_indexed_clip then
    clip_top = math.max(safe_effect_value("クリッピング", "上") or 0, 0)
    clip_bottom = math.max(safe_effect_value("クリッピング", "下") or 0, 0)
    clip_left = math.max(safe_effect_value("クリッピング", "左") or 0, 0)
    clip_right = math.max(safe_effect_value("クリッピング", "右") or 0, 0)
end

-- Compose the output item's base transform with the script/effect-relative transform.
-- AviUtl2 SDK: obj.ox/obj.sx/... are relative to the image output item's parameters.
-- Position/rotation/center are additive, scale is multiplicative.
local output_x = obj.getvalue("x") or obj.x or 0
local output_y = obj.getvalue("y") or obj.y or 0
local output_sx = obj.getvalue("sx") or 1
local output_sy = obj.getvalue("sy") or 1
local output_cx = obj.getvalue("cx") or 0
local output_cy = obj.getvalue("cy") or 0
local output_cz = obj.getvalue("cz") or 0
local output_rz = obj.getvalue("rz") or 0

-- Preserve the original relative-center transform. Native Light / Outline and
-- the dual-color mixing path can change the current object image rectangle.
-- On a reduced 4K proxy that can also change the current obj.cx/obj.cy state,
-- which must NOT be reused later when drawing the environment-blend mask.
local source_relative_cx = obj.cx or 0
local source_relative_cy = obj.cy or 0
local source_relative_cz = obj.cz or 0

local base_x = output_x + (obj.ox or 0)
local base_y = output_y + (obj.oy or 0)
local scale_x = output_sx * (obj.sx or 1)
local scale_y = output_sy * (obj.sy or 1)
local center_x = output_cx + source_relative_cx
local center_y = output_cy + source_relative_cy
local center_z = output_cz + source_relative_cz
local rz = (output_rz + (obj.rz or 0)) * pi / 180
local cos_r = math.cos(rz)
local sin_r = math.sin(rz)
local screen_center_x = screen_w * 0.5 + base_x
local screen_center_y = screen_h * 0.5 + base_y

-- Preview guide and coordinate handling for the lighting mask.
--
-- Normal mode:
--   mask_x / mask_y are object-local coordinates, therefore the mask follows
--   the character.
--
-- Fixed-light mode:
--   mask_x / mask_y are screen-space coordinates (same coordinate system as
--   the object's standard X/Y output), therefore the light stays fixed while
--   the character moves through it.
local fixed_enabled = fixed_light == 1 or fixed_light == true
local current_mask_type = mask_type
if current_mask_type == nil or current_mask_type == "" then
    current_mask_type = "円"
end

local function screen_relative_to_object_local(rel_x, rel_y)
    local target_x = screen_w * 0.5 + rel_x
    local target_y = screen_h * 0.5 + rel_y
    local dx = target_x - screen_center_x
    local dy = target_y - screen_center_y

    local inv_x = dx * cos_r + dy * sin_r
    local inv_y = -dx * sin_r + dy * cos_r

    local safe_scale_x = scale_x
    local safe_scale_y = scale_y
    if math.abs(safe_scale_x) < 0.00001 then
        safe_scale_x = safe_scale_x < 0 and -0.00001 or 0.00001
    end
    if math.abs(safe_scale_y) < 0.00001 then
        safe_scale_y = safe_scale_y < 0 and -0.00001 or 0.00001
    end

    return inv_x / safe_scale_x, inv_y / safe_scale_y
end

local effective_mask_x = mask_x
local effective_mask_y = mask_y
if fixed_enabled then
    effective_mask_x, effective_mask_y = screen_relative_to_object_local(mask_x, mask_y)
end

local function build_mask_guide_points(shape_name, cx, cy, size, aspect, rotation_deg)
    local points = {}
    local radius = math.max(size, 0) * 0.5
    local radius_x = radius
    local radius_y = radius
    local guide_aspect = clamp(aspect, -100, 100) / 100

    -- Match AviUtl2's native Mask aspect-ratio direction:
    -- positive values compress X, negative values compress Y.
    if guide_aspect >= 0 then
        radius_x = radius_x * (1 - guide_aspect)
    else
        radius_y = radius_y * (1 + guide_aspect)
    end

    local guide_r = rotation_deg * pi / 180
    local guide_cos = math.cos(guide_r)
    local guide_sin = math.sin(guide_r)

    local function push(x, y)
        local gx = x * guide_cos - y * guide_sin
        local gy = x * guide_sin + y * guide_cos
        points[#points + 1] = cx + gx
        points[#points + 1] = cy + gy
    end

    local shape = tostring(shape_name or "円")
    local lower = string.lower(shape)

    -- The actual masking uses AviUtl2's native Mask type directly.
    -- This preview guide only approximates the common built-in shapes.
    if string.find(shape, "四角") or string.find(lower, "square") or string.find(lower, "rect") then
        push(-radius_x, -radius_y)
        push(radius_x, -radius_y)
        push(radius_x, radius_y)
        push(-radius_x, radius_y)
    elseif string.find(shape, "菱") or string.find(lower, "diamond") then
        push(0, -radius_y)
        push(radius_x, 0)
        push(0, radius_y)
        push(-radius_x, 0)
    elseif string.find(shape, "三角") or string.find(lower, "triangle") then
        push(0, -radius_y)
        push(radius_x, radius_y)
        push(-radius_x, radius_y)
    else
        local guide_segments = 64
        for i = 0, guide_segments - 1 do
            local a = i * pi * 2 / guide_segments
            push(math.cos(a) * radius_x, math.sin(a) * radius_y)
        end
    end

    return points, #points / 2
end

local function object_local_to_screen_relative(local_x, local_y)
    -- Convert the SAME local coordinates used by the actual Mask effect into
    -- screen-anchor coordinates. This includes the object's scale + rotation.
    --
    -- "screen" anchor coordinates are relative to the composition center, so
    -- base_x / base_y are added after the local transform.
    local lx = local_x * scale_x
    local ly = local_y * scale_y
    local rx = lx * cos_r - ly * sin_r
    local ry = lx * sin_r + ly * cos_r
    return base_x + rx, base_y + ry
end

if obj.getoption("gui") then
    -- Both modes expose a draggable center handle.
    if fixed_enabled then
        obj.setanchor("mask_x,mask_y", 0, "screen")
    else
        obj.setanchor("mask_x,mask_y", 0)
    end

    if fixed_enabled then
        -- IMPORTANT:
        -- The actual Mask still lives in object-local space after the fixed
        -- screen center has been converted by screen_relative_to_object_local().
        -- Therefore its displayed outline must be built in that SAME local
        -- space first, then transformed to screen coordinates.
        --
        -- The previous preview incorrectly used mask_size directly as screen
        -- pixels, so object scale/rotation made the big guide circle disagree
        -- with the real covered area.
        local local_points, guide_count = build_mask_guide_points(
            current_mask_type,
            effective_mask_x,
            effective_mask_y,
            mask_size,
            mask_aspect,
            mask_rotation
        )

        if guide_count >= 2 then
            local screen_points = {}
            for i = 1, #local_points, 2 do
                local sx, sy = object_local_to_screen_relative(
                    local_points[i],
                    local_points[i + 1]
                )
                screen_points[#screen_points + 1] = sx
                screen_points[#screen_points + 1] = sy
            end
            obj.setanchor(screen_points, guide_count, "loop", "screen")
        end
    else
        local guide_points, guide_count = build_mask_guide_points(
            current_mask_type,
            effective_mask_x,
            effective_mask_y,
            mask_size,
            mask_aspect,
            mask_rotation
        )

        if guide_count >= 2 then
            obj.setanchor(guide_points, guide_count, "loop")
        end
    end
end

-- Convert an object-local coordinate directly to framebuffer coordinates.
-- mask_x / mask_y use this same local coordinate system, so color sampling
-- can follow the Mask center even when that center is outside the character.
local function object_local_to_framebuffer(local_x, local_y)
    local lx = local_x * scale_x
    local ly = local_y * scale_y
    local rx = lx * cos_r - ly * sin_r
    local ry = lx * sin_r + ly * cos_r
    return math.floor(screen_center_x + rx + 0.5), math.floor(screen_center_y + ry + 0.5)
end

-- Local background color and brightness sampling.
--
-- The Mask center remains the origin of color judgment, but the algorithm now
-- estimates "light color" instead of simply averaging every nearby surface.
--
-- Why:
-- A dark green object / palm leaf / codec noise can be highly saturated and
-- therefore win a normal color average even though it is not a light source.
-- The sampler first searches for brighter pixels around the Mask center, then
-- calculates the lighting color only from that "light candidate" pool.
--
-- Mono: one light color around the Mask center.
-- Dual: left/right light candidates around the same Mask center are evaluated
-- separately.

local COLOR_MODE_SINGLE = 0
local COLOR_MODE_DUAL = 1
local STYLE_GRADIENT = 0
local STYLE_OUTLINE = 1

local color_mode_value =
    math.floor(clamp(tonumber(color_mode) or COLOR_MODE_SINGLE, COLOR_MODE_SINGLE, COLOR_MODE_DUAL))
local lighting_style =
    math.floor(clamp(tonumber(light_style) or STYLE_GRADIENT, STYLE_GRADIENT, STYLE_OUTLINE))
local backlight_enabled =
    backlight_mode == 1 or backlight_mode == true
local brightness_link_enabled =
    brightness_link == 1 or brightness_link == true

local global_color = {245, 245, 245}
local left_color = {245, 245, 245}
local right_color = {245, 245, 245}

-- Automatic brightness factor from the Mask-center background.
-- 0 = no usable background light, 1 = full user-set lighting strength.
local global_light_factor = 0
local left_light_factor = 0
local right_light_factor = 0

if has_background then
    -- Force a fresh read from the current framebuffer before sampling.
    obj.pixeloption("get", "framebuffer")

    -- Sampling is intentionally local to the Mask center:
    -- Color judgment is now strictly local to the Mask center.
    --
    -- The previous wide search area could let a distant bright object win the
    -- color vote even when the Mask center itself was over a flat color.
    -- That was especially visible on simple test images: a green area could
    -- unexpectedly produce a blue backlight.
    --
    -- We now average only a small circular patch around the Mask center.
    -- This is still more stable than reading a single pixel, but it no longer
    -- allows unrelated distant lights to take over the hue.
    local pickup_radius = clamp(mask_size * 0.04, 36, 120)

    local grid = 11
    local half = (grid - 1) * 0.5
    local samples = {}

    for gy = 0, grid - 1 do
        local ny = (gy - half) / half
        for gx = 0, grid - 1 do
            local nx = (gx - half) / half
            local dist2 = nx * nx + ny * ny

            if dist2 <= 1.0 then
                local local_x = effective_mask_x + nx * pickup_radius
                local local_y = effective_mask_y + ny * pickup_radius
                local fx, fy = object_local_to_framebuffer(local_x, local_y)

                if fx >= 0 and fy >= 0 and fx < screen_w and fy < screen_h then
                    local r, g, b, a = obj.getpixel(fx, fy, "rgb")
                    if r and a and a > 0 then
                        local lum = luminance(r, g, b)
                        local max_rgb = math.max(r, g, b)
                        local min_rgb = math.min(r, g, b)

                        samples[#samples + 1] = {
                            r = r,
                            g = g,
                            b = b,
                            lum = lum,
                            chroma = (max_rgb - min_rgb) / 255,
                            side = nx,
                            dist2 = dist2,
                            alpha = a / 255
                        }
                    end
                end
            end
        end
    end

    local function filter_side(source, want_left)
        local out = {}
        for i = 1, #source do
            local s = source[i]
            if (want_left and s.side < 0) or
               ((not want_left) and s.side >= 0) then
                out[#out + 1] = s
            end
        end
        return out
    end

    local function estimate_center_color(source, fallback)
        local use = source
        if #use < 6 and fallback then
            use = fallback
        end

        if #use == 0 then
            return 0, 0, 0, 0
        end

        local sum_r, sum_g, sum_b = 0, 0, 0
        local sum_lum = 0
        local sum_w = 0

        local hue_vec_x = 0
        local hue_vec_y = 0
        local hue_weight_sum = 0

        for i = 1, #use do
            local s = use[i]

            -- Center pixels matter most. The rim is only there to stabilize
            -- video/noise and boundary transitions.
            local spatial_weight = 1.0 - 0.72 * s.dist2
            local w = s.alpha * spatial_weight

            if w > 0.000001 then
                sum_r = sum_r + s.r * w
                sum_g = sum_g + s.g * w
                sum_b = sum_b + s.b * w
                sum_lum = sum_lum + s.lum * w
                sum_w = sum_w + w

                -- Measure whether the local colored pixels agree on a hue.
                local h, sat, _ = rgb_to_hsl(s.r, s.g, s.b)
                local chroma_vote =
                    w *
                    clamp((s.chroma - 0.018) / 0.18, 0, 1) *
                    clamp(sat, 0, 1)

                if chroma_vote > 0.000001 then
                    local angle = h * pi * 2
                    hue_vec_x = hue_vec_x + math.cos(angle) * chroma_vote
                    hue_vec_y = hue_vec_y + math.sin(angle) * chroma_vote
                    hue_weight_sum = hue_weight_sum + chroma_vote
                end
            end
        end

        if sum_w <= 0.00001 then
            return 0, 0, 0, 0
        end

        local r = clamp(math.floor(sum_r / sum_w + 0.5), 0, 255)
        local g = clamp(math.floor(sum_g / sum_w + 0.5), 0, 255)
        local b = clamp(math.floor(sum_b / sum_w + 0.5), 0, 255)
        local mean_lum = sum_lum / sum_w

        -- Hue confidence is intentionally conservative.
        -- A uniform green/red/blue patch gets a high value; mixed colors
        -- become more neutral instead of suddenly choosing one side.
        local hue_agreement = 0
        if hue_weight_sum > 0.00001 then
            hue_agreement =
                math.sqrt(hue_vec_x * hue_vec_x + hue_vec_y * hue_vec_y) /
                hue_weight_sum
        end
        hue_agreement = clamp(hue_agreement, 0, 1)

        local avg_max = math.max(r, g, b)
        local avg_min = math.min(r, g, b)
        local avg_chroma = (avg_max - avg_min) / 255
        local color_presence = clamp((avg_chroma - 0.015) / 0.16, 0, 1)
        local auto_confidence = hue_agreement * color_presence

        local tr, tg, tb = tune_backlight_color(r, g, b, color_mix)
        tr, tg, tb = apply_auto_color_confidence(
            tr, tg, tb, auto_confidence
        )

        local fr, fg, fb = apply_color_density(
            tr, tg, tb, color_density
        )

        -- Black means no usable environmental light.
        -- The user's Strength acts as the maximum; actual strength fades in
        -- smoothly as the Mask-center patch becomes brighter.
        local light_factor = clamp((mean_lum - 8) / 80, 0, 1)
        light_factor =
            light_factor * light_factor * (3 - 2 * light_factor)

        return fr, fg, fb, light_factor
    end

    if #samples > 0 then
        local gr, gg, gb, gf = estimate_center_color(samples, nil)
        global_color = {gr, gg, gb}
        global_light_factor = gf or 0

        if color_mode_value == COLOR_MODE_DUAL then
            local left = filter_side(samples, true)
            local right = filter_side(samples, false)

            local lr, lg, lb, lf = estimate_center_color(left, samples)
            local rr, rg, rb, rf = estimate_center_color(right, samples)

            left_color = {lr, lg, lb}
            right_color = {rr, rg, rb}
            left_light_factor = lf or 0
            right_light_factor = rf or 0
        end
    end

    obj.pixeloption("get", "object")
end

local function color_value(c)
    -- AviUtl2 color parameters use a numeric RGB value (0x000000..0xffffff).
    -- Do not pass a hexadecimal string here: values near certain RGB ranges
    -- can be interpreted inconsistently by the effect parameter parser.
    return RGB(
        clamp(math.floor(c[1] + 0.5), 0, 255),
        clamp(math.floor(c[2] + 0.5), 0, 255),
        clamp(math.floor(c[3] + 0.5), 0, 255)
    )
end


-- -------------------------------------------------------------------------
-- Memory-adaptive rendering
--
-- AviUtl2 internally uses RGBA 16-bit float images. Large source PNG/PSD
-- textures therefore become expensive very quickly when several full-size
-- cache buffers are alive at once.
--
-- The character itself is still drawn at its ORIGINAL resolution.
-- Only the soft backlight working image is automatically reduced when the
-- source is very large. This keeps high-resolution line art sharp while
-- preventing the Light / cache chain from exhausting VRAM.
-- -------------------------------------------------------------------------

-- Only rebuild a larger transparent canvas when standard clipping is
-- actually present.
--
-- Earlier builds always enlarged the work canvas to contain the whole lighting
-- circle, even for an ordinary un-clipped image. That forced a needless
-- object -> tempbuffer -> object copy at 1:1 scale. Besides subtly changing
-- sampling, that created the "X=86 -> 87 jumps by one pixel" behaviour.
--
-- With no clipping, keep the original object buffer untouched and let
-- AviUtl2's native obj.draw() transform handle X/Y/Z and Center X/Y/Z.
local has_standard_clipping =
    (clip_top + clip_bottom + clip_left + clip_right) > 0.0001

local unclipped_w = src_w
local unclipped_h = src_h
local canvas_w = src_w
local canvas_h = src_h
local source_offset_x = 0
local source_offset_y = 0

if has_standard_clipping then
    -- Reconstruct the image rectangle before clipping.
    unclipped_w = math.max(src_w + clip_left + clip_right, src_w)
    unclipped_h = math.max(src_h + clip_top + clip_bottom, src_h)

    -- In the clipping path only, keep enough transparent canvas around the
    -- processed image for the lighting area. This preserves support for
    -- heavily clipped 4000x4000 artwork.
    local mask_radius = math.max(mask_size, 0) * 0.5
    local mask_radius_x = mask_radius
    local mask_radius_y = mask_radius
    local canvas_aspect = clamp(mask_aspect, -100, 100) / 100

    -- Keep the clipping-support canvas consistent with the native Mask:
    -- positive values compress X, negative values compress Y.
    if canvas_aspect >= 0 then
        mask_radius_x = mask_radius_x * (1 - canvas_aspect)
    else
        mask_radius_y = mask_radius_y * (1 + canvas_aspect)
    end

    local mask_r = mask_rotation * pi / 180
    local mask_cos = math.cos(mask_r)
    local mask_sin = math.sin(mask_r)
    local mask_extent_x =
        math.abs(mask_cos) * mask_radius_x +
        math.abs(mask_sin) * mask_radius_y +
        math.max(mask_blur, 0)
    local mask_extent_y =
        math.abs(mask_sin) * mask_radius_x +
        math.abs(mask_cos) * mask_radius_y +
        math.max(mask_blur, 0)

    local canvas_half_w = math.max(
        unclipped_w * 0.5,
        math.abs(effective_mask_x) + mask_extent_x
    )
    local canvas_half_h = math.max(
        unclipped_h * 0.5,
        math.abs(effective_mask_y) + mask_extent_y
    )

    canvas_w = math.max(1, math.ceil(canvas_half_w * 2))
    canvas_h = math.max(1, math.ceil(canvas_half_h * 2))

    local extra_pad_x = (canvas_w - unclipped_w) * 0.5
    local extra_pad_y = (canvas_h - unclipped_h) * 0.5
    source_offset_x = extra_pad_x + clip_left
    source_offset_y = extra_pad_y + clip_top
end

local source_pixels = canvas_w * canvas_h
local max_work_dimension = 3072
local max_work_pixels = 6000000

local work_scale = 1.0
if canvas_w > max_work_dimension then
    work_scale = math.min(work_scale, max_work_dimension / canvas_w)
end
if canvas_h > max_work_dimension then
    work_scale = math.min(work_scale, max_work_dimension / canvas_h)
end
if source_pixels > max_work_pixels then
    work_scale = math.min(work_scale, math.sqrt(max_work_pixels / source_pixels))
end

-- Avoid microscopic resampling differences for ordinary-size artwork.
if work_scale > 0.995 then
    work_scale = 1.0
end

local work_w = math.max(1, math.floor(canvas_w * work_scale + 0.5))
local work_h = math.max(1, math.floor(canvas_h * work_scale + 0.5))
local work_inv_scale = 1.0 / work_scale

-- L2 + L3: brightness is applied to the original full-resolution character.
-- Draw it immediately, before we replace the current object with a smaller
-- light-working image.
obj.effect("色調補正", "明るさ", bright)
obj.setoption("blend", "none")
obj.draw()

-- Build a reduced working copy only when the source is unusually large.
--
-- Do NOT resize it with obj.draw() into tempbuffer. Filters such as
-- Clipping can change the object's image rectangle/origin, while tempbuffer
-- drawing ignores the object's normal transform. On very large artwork that
-- mismatch can move the lighting proxy away from the processed image and make
-- the lighting appear to disappear.
--
-- Instead, resize the current processed object buffer directly with a pixel
-- shader. UV 0..1 maps the complete post-effect image to the reduced buffer, so
-- clipping and other size-changing effects remain aligned.
local needs_proxy_canvas =
    work_scale < 1.0 or
    has_standard_clipping

if needs_proxy_canvas then
    obj.clearbuffer("tempbuffer", work_w, work_h)
    local proxy_sampler = "dot"
    if work_scale < 1.0 then
        proxy_sampler = "clamp"
    end

    obj.pixelshader(
        "backlight_proxy_resize",
        "tempbuffer",
        "object",
        {
            src_w,
            src_h,
            canvas_w,
            canvas_h,

            source_offset_x,
            source_offset_y,
            0,
            0
        },
        "copy",
        proxy_sampler
    )
    obj.copybuffer("object", "tempbuffer")
end

-- This is now the only persistent character-sized base cache.
-- For large artwork it is the reduced proxy, not the original 4K+ texture.
obj.copybuffer("cache:autobacklight_workbase", "object")

-- The large-image proxy no longer needs tempbuffer after workbase is cached.
-- Shrink the temporary surface before allocating background / dual-color
-- buffers to reduce peak VRAM usage on 4000x4000 artwork.
obj.clearbuffer("tempbuffer", 1, 1)


-- Prepare the blurred L1 background only after the original character has
-- already been converted into the small working copy. This avoids needing a
-- second full-resolution source cache just to restore the character.
if has_background and env_blend > 0 then
    obj.copybuffer("object", "cache:aul2_backlight_bg")
    obj.effect("ぼかし", "範囲", env_blur, "縦横比", 0, "光の強さ", 0, "サイズ固定", 1)
    obj.copybuffer("cache:aul2_backlight_bgblur", "object")
end

local work_diffusion = light_diffusion * work_scale
local work_mask_x = effective_mask_x * work_scale
local work_mask_y = effective_mask_y * work_scale
local work_mask_size = mask_size * work_scale
local work_mask_blur = mask_blur * work_scale

local function resolve_light_factor(light_factor)
    if not brightness_link_enabled then
        return 1.0
    end
    return clamp(light_factor or 0, 0, 1)
end

local function get_effective_strength(light_factor)
    return light_strength * resolve_light_factor(light_factor)
end

local function apply_light(color, light_factor)
    local effective_strength =
        get_effective_strength(light_factor)

    obj.effect(
        "ライト",
        "強さ", effective_strength,
        "拡散", work_diffusion,
        "比率", light_ratio,
        "逆光", backlight_enabled and 1 or 0,
        "color", color_value(color)
    )
end


local function apply_outline(color, light_factor)
    local effective_strength =
        get_effective_strength(light_factor)

    -- In Outline mode, Spread becomes the TOTAL rim width.
    local total_width =
        clamp(1.0 + work_diffusion * 0.30, 1.0, 64.0)

    -- Reuse Bias as the inside/outside distribution:
    --  -100 = all outside
    --     0 = half outside / half inside
    --  +100 = all inside
    local inside_ratio =
        clamp((light_ratio + 100.0) / 200.0, 0.0, 1.0)

    local inner_width = total_width * inside_ratio
    local outer_width = total_width * (1.0 - inside_ratio)

    local base_w = obj.w
    local base_h = obj.h

    -- AviUtl2's native Outline effect is used for the outside portion.
    -- At +100 Bias the outside size becomes 0, leaving only the inner rim.
    obj.effect(
        "縁取り",
        "サイズ", outer_width,
        "ぼかし", 0,
        "color", color_value(color)
    )

    local outline_w = obj.w
    local outline_h = obj.h

    -- Keep the native outer rim, generate an inner rim from the original alpha,
    -- and combine the two into one transparent rim layer.
    obj.pixelshader(
        "backlight_outline_only",
        "object",
        {
            "object",
            "cache:autobacklight_workbase"
        },
        {
            outline_w,
            outline_h,
            base_w,
            base_h,

            color[1] / 255,
            color[2] / 255,
            color[3] / 255,
            effective_strength,

            inner_width,
            0,
            0,
            0
        },
        "copy",
        "clamp"
    )
end

if color_mode_value == COLOR_MODE_SINGLE then
    -- Single-color mode needs only one reduced working image.
    obj.copybuffer("object", "cache:autobacklight_workbase")

    if lighting_style == STYLE_OUTLINE then
        -- Outline: use the native Outline effect instead of Light.
        apply_outline(global_color, global_light_factor)
    else
        -- Gradient: keep the native Light implementation.
        apply_light(global_color, global_light_factor)
    end
else
    -- Dual-color mode used to allocate another large persistent cache for the
    -- left lighting pass. With a 4000x4000 source, the reduced proxy is still
    -- around six million pixels, so that extra surface can exhaust the frame's
    -- image-buffer budget before Background Blend creates its mask/background
    -- buffers.
    --
    -- Reuse tempbuffer for the left pass instead. AviUtl2 allows tempbuffer to
    -- be used directly as a pixelshader resource, so no second character-sized
    -- cache is necessary.
    obj.copybuffer("object", "cache:autobacklight_workbase")
    if lighting_style == STYLE_OUTLINE then
        apply_outline(left_color, left_light_factor)
    else
        apply_light(left_color, left_light_factor)
    end
    obj.copybuffer("tempbuffer", "object")

    obj.copybuffer("object", "cache:autobacklight_workbase")
    if lighting_style == STYLE_OUTLINE then
        apply_outline(right_color, right_light_factor)
    else
        apply_light(right_color, right_light_factor)
    end

    obj.pixelshader(
        "backlight_dualcolor_mix",
        "object",
        {
            "tempbuffer",
            "object"
        },
        {
            0.55, 0, 0, 0
        },
        "copy",
        "clamp"
    )

    -- The left image is no longer needed after mixing.
    obj.clearbuffer("tempbuffer", 1, 1)
end

-- Apply the shared mask in the proxy's pixel units. The final draw is enlarged
-- by the inverse proxy scale, so the on-screen mask size stays identical to
-- the user-facing parameters.
obj.effect(
    "マスク",
    "X", work_mask_x,
    "Y", work_mask_y,
    "回転", mask_rotation,
    "サイズ", work_mask_size,
    "縦横比", mask_aspect,
    "ぼかし", work_mask_blur,
    "type", current_mask_type,
    "マスクの反転", 0,
    "元のサイズに合わせる", 0
)

-- L4-L7: restore the proxy to the original on-screen size.
--
-- Large-image proxy center correction:
-- The proxy image is work_scale times smaller than the source, therefore the
-- effective center coordinates used when the proxy is enlarged must also be
-- work_scale times smaller.  Otherwise changing the output Center X / Y / Z makes
-- the proxy's original-image component shift away from the full-resolution
-- character and appear as a duplicated/ghost image.
--
-- obj.getvalue("cx"/"cy"/"cz") is the base center and obj.cx/obj.cy/obj.cz are writable
-- relative-center offsets.  Add a temporary relative correction so that:
--
--   output_center + corrected_relative_center
--     = (output_center + original_relative_center) * work_scale
--
-- Restore the original values immediately after drawing so the rest of the
-- script and following processing see the user's original transform.
local saved_relative_cx = obj.cx or 0
local saved_relative_cy = obj.cy or 0
local saved_relative_cz = obj.cz or 0

if work_scale < 1.0 then
    obj.cx = saved_relative_cx + center_x * (work_scale - 1.0)
    obj.cy = saved_relative_cy + center_y * (work_scale - 1.0)
    obj.cz = saved_relative_cz + center_z * (work_scale - 1.0)
end

obj.setoption("blend", "none")
obj.draw(0, 0, 0, work_inv_scale)

if work_scale < 1.0 then
    obj.cx = saved_relative_cx
    obj.cy = saved_relative_cy
    obj.cz = saved_relative_cz
end

-- L8-L10 environment Multiply.
--
-- Previous versions reconstructed the object's screen position inside the
-- framebuffer shader from X/Y, scale, rotation and Center X/Y. That worked in
-- 2D, but Z and Center Z are perspective-dependent, so the environment blend
-- could remain at the old depth while the object itself moved in Z.
--
-- Build the alpha mask in framebuffer space with obj.draw() instead. AviUtl2
-- then applies the exact same object transform and camera projection to this
-- mask as it does to the object, including Z and Center Z.
if has_background and env_blend > 0 then
    local multiply_opacity = clamp(env_blend / 100, 0, 1)

    local has_pre_env = obj.copybuffer(
        "cache:autobacklight_pre_env",
        "framebuffer"
    )

    if has_pre_env then
        -- Rebuild only the object's alpha mask in screen space.
        obj.copybuffer("object", "cache:autobacklight_workbase")

        -- Save the CURRENT state only so it can be restored afterwards.
        -- For the mask draw itself, always start from the object's ORIGINAL
        -- relative center captured before the Lighting path ran.
        --
        -- This matters in Dual Color + very large-image mode: the two native
        -- Light passes and their image-size changes can leave the current
        -- relative center different from the source object's transform. The
        -- previous code then applied the 4K proxy correction on top of that
        -- altered value, moving the environment mask away from the character.
        local env_restore_cx = obj.cx or 0
        local env_restore_cy = obj.cy or 0
        local env_restore_cz = obj.cz or 0

        obj.cx = source_relative_cx
        obj.cy = source_relative_cy
        obj.cz = source_relative_cz

        if work_scale < 1.0 then
            obj.cx = source_relative_cx + center_x * (work_scale - 1.0)
            obj.cy = source_relative_cy + center_y * (work_scale - 1.0)
            obj.cz = source_relative_cz + center_z * (work_scale - 1.0)
        end

        obj.clearbuffer("framebuffer")
        obj.setoption("blend", "none")
        obj.draw(0, 0, 0, work_inv_scale)
        local has_env_mask = obj.copybuffer(
            "cache:autobacklight_envmask",
            "framebuffer"
        )

        obj.cx = env_restore_cx
        obj.cy = env_restore_cy
        obj.cz = env_restore_cz

        -- Restore the already-composited object + lighting before applying
        -- the environment multiply.
        obj.copybuffer("framebuffer", "cache:autobacklight_pre_env")

        if has_env_mask then
            obj.pixelshader(
                "backlight_env_framebuffer",
                "framebuffer",
                {
                    "cache:autobacklight_pre_env",
                    "cache:autobacklight_envmask",
                    "cache:aul2_backlight_bgblur"
                },
                {
                    multiply_opacity, 0, 0, 0
                },
                "copy",
                "clamp"
            )
        end
    end
end
